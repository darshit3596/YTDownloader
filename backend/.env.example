# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ── Storage / database ──────────────────────────────────
# Relative to backend/prisma when used by Prisma.
DATABASE_URL="file:../../storage/mediaflow.db"
# Optional absolute override for uploads/downloads/temp.
# STORAGE_ROOT=C:\mediaflow-storage

# ── Limits ──────────────────────────────────────────────
MAX_UPLOAD_MB=512
MAX_REMOTE_FILE_MB=1024
MAX_CONCURRENT_JOBS=1
AUTO_CLEANUP_HOURS=24
RATE_LIMIT_MAX=240
FFMPEG_TIMEOUT_MINUTES=45

# ── Media tooling ───────────────────────────────────────
# Leave blank to use the bundled ffmpeg-static / ffprobe-static binaries.
# FFMPEG_PATH=
# FFPROBE_PATH=
# YTDLP_PATH=yt-dlp

# ── Official YouTube Data API v3 ────────────────────────
# Optional. When empty, YouTube links return a clear "not configured" error.
# Metadata only — no stream extraction is ever attempted.
YOUTUBE_API_KEY=

# ── Frontend (Vite) ─────────────────────────────────────
# VITE_API_URL=/api
# VITE_SOCKET_URL=
